# 数据库连接（复制本文件为 .env 并填入真实值）
DATABASE_URL=mysql+pymysql://root:你的密码@127.0.0.1:3306/lab_agent

# JWT 配置
JWT_SECRET_KEY=请替换为随机密钥
JWT_EXPIRE_HOURS=24
JWT_ALGORITHM=HS256

# 前端跨域来源（多个用英文逗号分隔）
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# AI 助手（OpenAI 兼容接口）
# Agent 依赖工具调用（Function Calling）：Ollama 本地模型建议 qwen2.5:7b，
# deepseek-r1:7b 可能不返回 tool_calls，会退化成普通文本回答。
LLM_API_KEY=请填入API密钥
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# 本地 Ollama 向量模型
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=bge-m3:latest
